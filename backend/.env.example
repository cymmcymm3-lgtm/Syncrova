# Server
NODE_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret

# MongoDB Atlas. Keep the database path and explicit name pointed at the
# existing production data; do not create a new empty database by mistake.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/IntegrativeProgramming?retryWrites=true&w=majority
MONGODB_DB_NAME=IntegrativeProgramming
# Short-lived cache for password/session validation. Set to 0 to disable.
AUTH_SESSION_CACHE_TTL_MS=15000

# Browser origin(s). Separate multiple origins with commas.
CLIENT_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:5000

# Cloudflare R2 media storage
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Optional realtime calls
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional admin provisioning
ADMIN_EMAILS=
ADMIN_REGISTRATION_CODE=
