# Public build-time URL of the Render API. Do not include /api at the end.
VITE_BACKEND_URL=https://your-render-service.onrender.com

# Optional whole-request timeout in milliseconds (default: 30000; maximum: 120000).
# Increase this only when uploads or a cold backend legitimately need more time.
VITE_API_TIMEOUT_MS=30000
